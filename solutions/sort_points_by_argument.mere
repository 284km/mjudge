// Library Checker "Sort Points by Argument"
// https://judge.yosupo.jp/problem/sort_points_by_argument
//
// The problem that cannot avoid handing a comparator to a generic sort, which
// is the shape that costs 24 bytes per comparison. n is 200,000, so the sort
// makes about 3.5 million comparisons -- watch the alloc column.
//
// The comparator is the reference solution's, in integers: points are bucketed
// by half-plane and then ordered by the sign of the cross product. |x|,|y| are
// at most 1e9, so the cross product fits in 64 bits with room to spare.

// --- input: the same fifteen lines in every solution --------------------------
// Stage 1 forbids a library of our own, so this is copied per file. That the
// copy is identical every time is the finding, not an accident.
let next_int = fn (b: bytes) -> fn (n: int) -> fn pos ->
  let rec skip = fn (i: int) ->
    if i >= n then i
    else
      let c = bytes_get b i in
      if (c >= 48 && c <= 57) || c == 45 then i else skip (i + 1) in
  let s = skip (vec_get pos 0) in
  let neg = if s >= n then false else bytes_get b s == 45 in
  let rec digits = fn (i: int) -> fn (acc: int) ->
    if i >= n then { vec_set pos 0 i; acc }
    else
      let c = bytes_get b i in
      if c >= 48 && c <= 57 then digits (i + 1) (acc * 10 + (c - 48))
      else { vec_set pos 0 i; acc } in
  let v = digits (if neg then s + 1 else s) 0 in
  if neg then 0 - v else v;

type P = { x: int, y: int };

let half = fn (p: P) ->
  if p.y < 0 then 0 - 1
  else if p.y == 0 && p.x >= 0 then 0
  else 1;

let cmp = fn (a: P) -> fn (b: P) ->
  let ha = half a in
  let hb = half b in
  if ha != hb then ha - hb
  else
    let cross = a.x * b.y - a.y * b.x in
    if cross > 0 then 0 - 1 else if cross < 0 then 1 else 0;

let solve = fn () ->
  let b = bytes_of_str (read_stdin ()) in
  let len = bytes_len b in
  let pos = vec_new () in
  let _ = vec_push pos 0 in
  let n = next_int b len pos in
  let ps = vec_new () in
  let rec read = fn (i: int) ->
    if i >= n then ()
    else
      let x = next_int b len pos in
      let y = next_int b len pos in
      // `{ x = x, y = y }` on its own here is read as a BLOCK, not a record:
      // the named form is what disambiguates it inside another block.
      { vec_push ps (P { x = x, y = y }); read (i + 1) } in
  let _ = read 0 in
  let _ = vec_sort ps cmp in
  let out = strbuf_new () in
  let rec emit = fn (i: int) ->
    if i >= n then ()
    else
      let p = vec_get ps i in
      {
        strbuf_push out (str_of_int p.x); strbuf_push out " ";
        strbuf_push out (str_of_int p.y); strbuf_push out "\n";
        emit (i + 1)
      } in
  let _ = emit 0 in
  print_no_nl (strbuf_to_str out);

let _ = solve ();
let _ = exit 0;
