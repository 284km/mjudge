// Library Checker "Static Range Sum" — https://judge.yosupo.jp/problem/static_range_sum
//
// Prefix sums. a_i is up to 1e9 and N up to 500,000, so the prefix array needs
// 64-bit elements -- which int is on the C backend, and 63-bit on the
// interpreter. Worth knowing which one a board row was produced by.

// --- input: the same fifteen lines in every solution --------------------------
// Stage 1 forbids a library of our own, so this is copied per file. That the
// copy is identical every time is the finding, not an accident.
let next_int = fn (b: bytes) -> fn (n: int) -> fn pos ->
  let rec skip = fn (i: int) ->
    if i >= n then i
    else
      let c = bytes_get b i in
      if (c >= 48 && c <= 57) || c == 45 then i else skip (i + 1) in
  let s = skip (vec_get pos 0) in
  let neg = if s >= n then false else bytes_get b s == 45 in
  let rec digits = fn (i: int) -> fn (acc: int) ->
    if i >= n then { vec_set pos 0 i; acc }
    else
      let c = bytes_get b i in
      if c >= 48 && c <= 57 then digits (i + 1) (acc * 10 + (c - 48))
      else { vec_set pos 0 i; acc } in
  let v = digits (if neg then s + 1 else s) 0 in
  if neg then 0 - v else v;

let solve = fn () ->
  let b = bytes_of_str (read_stdin ()) in
  let len = bytes_len b in
  let pos = vec_new () in
  let _ = vec_push pos 0 in
  let n = next_int b len pos in
  let q = next_int b len pos in
  let pre = vec_new () in
  let _ = vec_push pre 0 in
  let rec build = fn (i: int) ->
    if i >= n then ()
    else { vec_push pre (vec_get pre i + next_int b len pos); build (i + 1) } in
  let _ = build 0 in
  let out = strbuf_new () in
  let rec go = fn (k: int) ->
    if k >= q then ()
    else
      let l = next_int b len pos in
      let r = next_int b len pos in
      { strbuf_push out (str_of_int (vec_get pre r - vec_get pre l));
        strbuf_push out "\n"; go (k + 1) } in
  let _ = go 0 in
  print_no_nl (strbuf_to_str out);

solve ()
